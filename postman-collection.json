{
  "info": {
    "name": "Financial Analytics Dashboard API",
    "description": "API collection for the Financial Analytics Dashboard - Backend runs on http://localhost:5001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new user account"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login and receive a JWT token. Copy the token and set it in the collection variable 'token'."
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get All Transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?skip=0&limit=25&sortBy=date&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"],
              "query": [
                { "key": "skip", "value": "0", "description": "Pagination offset" },
                { "key": "limit", "value": "25", "description": "Items per page" },
                { "key": "sortBy", "value": "date", "description": "Field to sort by" },
                { "key": "sortOrder", "value": "desc", "description": "asc or desc" },
                { "key": "category", "value": "", "description": "Filter by category (Revenue/Expense)", "disabled": true },
                { "key": "status", "value": "", "description": "Filter by status", "disabled": true },
                { "key": "search", "value": "", "description": "Search in category/status", "disabled": true },
                { "key": "startDate", "value": "", "description": "Start date filter (ISO)", "disabled": true },
                { "key": "endDate", "value": "", "description": "End date filter (ISO)", "disabled": true }
              ]
            },
            "description": "Get paginated transactions with optional filters"
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/analytics/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analytics", "summary"]
            },
            "description": "Get total revenue, total expenses, total transactions, and net income"
          }
        },
        {
          "name": "Get Trends",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/analytics/trends",
              "host": ["{{baseUrl}}"],
              "path": ["api", "analytics", "trends"]
            },
            "description": "Get monthly revenue and expense trends"
          }
        }
      ]
    },
    {
      "name": "Export",
      "item": [
        {
          "name": "Export CSV",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"columns\": [\"id\", \"date\", \"amount\", \"category\", \"status\", \"user_id\"],\n  \"filters\": {}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/export/csv",
              "host": ["{{baseUrl}}"],
              "path": ["api", "export", "csv"]
            },
            "description": "Export transactions as CSV. Specify columns and optional filters."
          }
        }
      ]
    }
  ]
}